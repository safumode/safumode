{
  "name": "bnb-authorization-vault-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Local EVM vault security prototype; not production ready",
  "scripts": {
    "dev": "node web/dev.js",
    "build": "node web/build.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "safumode": "node scripts/safumode-monitor.js",
    "safumode:alerts": "node scripts/safumode-alerts.js",
    "test:safumode": "hardhat test test/SafumodeMonitor.e2e.js test/SafumodeAlerts.js",
    "test:e2e:ui": "hardhat compile && node scripts/e2e-local-ui.js",
    "test:e2e:lifecycle": "hardhat compile && node scripts/e2e-lifecycle-cli.js",
    "manifest:deploy:local": "hardhat compile && hardhat run scripts/deploy-local-manifest.js --network localhost",
    "manifest:verify:local": "node scripts/verify-local-manifest.js",
    "test:manifest": "hardhat test test/DeploymentManifest.js",
    "tx:prepare": "node scripts/safumode-cli.js prepare",
    "tx:relay": "node scripts/safumode-cli.js relay",
    "test:tx": "hardhat test test/SafumodeTx.js",
    "operator:drill": "hardhat run scripts/operator-drill.js --network hardhat",
    "test:drill": "hardhat test test/OperatorDrill.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.17",
    "puppeteer-core": "^24.43.1"
  },
  "dependencies": {
    "@ledgerhq/hw-app-eth": "^7.10.0",
    "@ledgerhq/hw-transport-node-hid": "^6.33.5"
  }
}
